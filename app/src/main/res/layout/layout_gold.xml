<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">


    <ImageView
        android:id="@+id/iv_gold"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="fitXY"
        android:src="@mipmap/bg_gold_defaul"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/tv_num"
        style="@style/tv_default_white"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#FFFFE483"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/iv_gold"
        app:layout_constraintEnd_toEndOf="@id/iv_gold"
        app:layout_constraintStart_toStartOf="@id/iv_gold"
        app:layout_constraintTop_toTopOf="@id/iv_gold"
        tools:text="24" />


    <!--    <TextView-->
    <!--        android:id="@+id/tv_task_num"-->
    <!--        style="@style/tv_default_white"-->
    <!--        android:layout_width="27dp"-->
    <!--        android:layout_height="20dp"-->
    <!--        android:gravity="center"-->
    <!--        android:text=""-->
    <!--        android:textColor="@color/white"-->
    <!--        android:textSize="16sp"-->
    <!--        android:textStyle="bold"-->
    <!--        app:layout_constraintEnd_toEndOf="@id/iv_gold"-->
    <!--        app:layout_constraintTop_toTopOf="@id/iv_gold" />-->


    <TextView
        android:id="@+id/tv_gold_name"
        style="@style/tv_default_white"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dip"
        android:ellipsize="end"
        android:gravity="center"
        android:lines="1"
        android:maxLength="6"
        android:text="哈哈哈哈哈哈哈哈哈"
        android:textColor="#6D6F73"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_gold"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_time"
        style="@style/tv_default"
        android:layout_width="40dp"
        android:layout_height="14dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_gold_time"
        android:gravity="center"
        android:text="33:33"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_gold_name"
        tools:visibility="visible" />


</androidx.constraintlayout.widget.ConstraintLayout>