    <style name="tv_default">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="tv_kedu" parent="tv_default">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">#FF178456</item>
    </style>

    <style name="tv_default_white" parent="tv_default">
        <!--        <item name="android:textSize">12sp</item>-->
        <item name="android:textColor">#ffffff</item>

    </style>

    <style name="tv_step_view">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>

    </style>

    <style name="iv_home">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
    </style>

    <style name="tv_home_content" parent="tv_default">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#FF959AA6</item>
    </style>
    <!--  首页标题-->
    <style name="tv_home_title" parent="tv_default">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">#ff333333</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:textStyle">bold</item>

    </style>

    <style name="tv_default_title" parent="tv_default_black">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>

    </style>

    <style name="tv_default_black" parent="tv_default">
        <!--        <item name="android:textSize">12sp</item>-->
        <item name="android:textColor">#333333</item>

    </style>
</resources>
