<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_list_dialog"
    android:orientation="vertical">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="30dp"
        android:src="@mipmap/topermission" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/dp16"
        android:gravity="center"
        android:text="系统检测到您有未开通的权限\n将会影响您的体验"
        android:textColor="#ff595757"
        android:textSize="15sp" />

    <Button
        android:id="@+id/cDialogPermissionGoto"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="30dp"
        android:layout_marginRight="20dp"
        android:background="@drawable/bg_permission_green"
        android:text="去授权"
        android:textColor="@color/white"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/cDialogPermissionReject"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        android:text="残忍拒绝"
        android:textColor="#ffb5b5b6"
        android:textSize="13sp" />
</LinearLayout>