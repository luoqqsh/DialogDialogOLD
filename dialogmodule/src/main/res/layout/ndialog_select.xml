<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#373c3d"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nSelectBack"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:scaleType="centerInside"
                android:src="@mipmap/icon_back" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:layout_toRightOf="@+id/nSelectBack"
                android:background="@android:color/black" />

            <TextView
                android:id="@+id/nSelectFolderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="12dp"
                android:layout_toRightOf="@+id/nSelectBack"
                android:text="全部图片"
                android:textColor="@android:color/white"
                android:textSize="18sp" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@+id/nSelectFolderName"
                android:layout_centerVertical="true"
                android:layout_marginLeft="2dp"
                android:layout_toRightOf="@+id/nSelectFolderName"
                android:src="@mipmap/text_indicator" />

            <FrameLayout
                android:id="@+id/nSelectConfirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="16dp"
                android:foreground="@drawable/btn_foreground_selector">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_green_shape"
                    android:gravity="center"
                    android:minWidth="50dp"
                    android:paddingLeft="5dp"
                    android:paddingTop="5dp"
                    android:paddingRight="5dp"
                    android:paddingBottom="5dp"
                    android:text="确定"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />

            </FrameLayout>

        </RelativeLayout>

        <TextView
            android:id="@+id/nSelectTip"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp35"
            android:background="#FFFFA97E"
            android:gravity="center"
            android:textColor="@color/white"
            android:visibility="gone" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/nSelectItemList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/black" />

            <View
                android:id="@+id/nSelectMasking"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#c4111212"
                android:visibility="gone" />
        </RelativeLayout>
    </LinearLayout>

</RelativeLayout>
