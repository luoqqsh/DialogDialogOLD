<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|center_vertical"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ScrollView
            android:id="@+id/nDialogBottomScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bottom_list_dialog">

            <LinearLayout
                android:id="@+id/nDialogBottomList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            </LinearLayout>

        </ScrollView>

        <View
            android:id="@+id/nDialogBottomLine1"
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <TextView
            android:id="@+id/nDialogBottomCancel"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_cancel_dialog"
            android:gravity="center"
            android:text="取消"
            android:textColor="#2b84fd"
            android:textSize="20sp" />

        <View
            android:id="@+id/nDialogBottomLine2"
            android:layout_width="match_parent"
            android:layout_height="12dp" />
    </LinearLayout>

</LinearLayout>