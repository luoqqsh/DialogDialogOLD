<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_weixin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawableTop="@mipmap/fx_weixin"
            android:drawablePadding="12dp"
            android:gravity="center"
            android:text="微信"
            android:textColor="#ff1a1a1a"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_pengyouquan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawableTop="@mipmap/fx__pengyouquan"
            android:drawablePadding="12dp"
            android:gravity="center"
            android:text="朋友圈"
            android:textColor="#ff1a1a1a"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_QQ"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawableTop="@mipmap/fx_qq"
            android:drawablePadding="12dp"
            android:gravity="center"
            android:text="QQ"
            android:textColor="#ff1a1a1a"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_sina"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawableTop="@mipmap/fx_gengduo"
            android:drawablePadding="12dp"
            android:gravity="center"
            android:text="新浪微博"
            android:textColor="#ff1a1a1a"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#fff0f0f0" />

    <TextView
        android:id="@+id/tv_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        android:text="取消"
        android:textColor="#ff1586dc"
        android:textSize="18sp" />
</LinearLayout>